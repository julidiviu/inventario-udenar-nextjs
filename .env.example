# Local (Docker compose de este repo, puerto 5433 para no chocar con tu postgres_db:5432 de Django)
DATABASE_URL=postgresql://postgres:postgres@localhost:5433/inventario

# Producción (Neon/Supabase). En Vercel usa la URL con pooler para la app
# y la URL directa solo para `drizzle-kit migrate`.
# DATABASE_URL=postgresql://user:password@ep-xxx-pooler.neon.tech/inventario?sslmode=require
# DIRECT_URL=postgresql://user:password@ep-xxx.neon.tech/inventario?sslmode=require

# Vercel Blob (Storage -> Create Store -> .env.local). Solo server.
BLOB_READ_WRITE_TOKEN=

# Auth: secreto HS256 para firmar la sesión JWT (cookie httpOnly, 2h).
# Genera uno con: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
AUTH_SECRET=
